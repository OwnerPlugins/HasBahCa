msgid "Access denied or wrong PIN"
msgstr "Aðgangi hafnað eða rangt PIN-númer"

msgid "Back"
msgstr "Til baka"

msgid "Congrats! You already have the latest version..."
msgstr "Til hamingju! Þú ert nú þegar með nýjustu útgáfuna..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Viltu setja upp uppfærslu ( %s ) núna?"

msgid "Download Failed!!!"
msgstr "Niðurhal mistókst!!!"

msgid "Downloaded: %d files"
msgstr "Sótt: %d skrár"

msgid "Downloading ALL playlists..."
msgstr "Sækir ALLA spilunarlista..."

msgid "Error checking version: %s"
msgstr "Villa við að athuga útgáfu: %s"

msgid "Exit"
msgstr "Hætta"

msgid "Failed: %d files\\\\\\\\n"
msgstr "Mistókst: %d skrár\\\\\\\\n"

msgid "Filter this category..."
msgstr "Sía þennan flokk..."

msgid "Force Update (Developer)"
msgstr "Þvinga uppfærslu (hönnuður)"

msgid "Give me a few seconds ... loading the data"
msgstr "Gefðu mér nokkrar sekúndur ... hleður gögnunum"

msgid "HasBahCa Favorites List have been removed"
msgstr "Uppáhaldslisti HasBahCa hefur verið fjarlægður"

msgid "Loading data... Please wait"
msgstr "Hleður gögnum... Vinsamlegast bíddu"

msgid "Options"
msgstr "Valmöguleikar"

msgid "Please now select ..."
msgstr "Vinsamlegast veldu núna..."

msgid "Remove"
msgstr "Fjarlægja"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "Fjarlægja alla HasBahCa uppáhalds vönd?"

msgid "Select"
msgstr "Veldu"

msgid "Select update type:"
msgstr "Veldu uppfærslugerð:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "Stokka uppáhalds %s lista í gangi"

msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "Hlaðið niður: %d skrár\\\\\\\\n"

msgid "Update Aborted!"
msgstr "Uppfærsla hætt!"

msgid "Update M3U Playlists from GitHub"
msgstr "Uppfærðu M3U lagalista frá GitHub"

msgid "Update Plugin to new version"
msgstr "Uppfærðu viðbótina í nýja útgáfu"

msgid "Wait please ..."
msgstr "Bíddu vinsamlega..."
