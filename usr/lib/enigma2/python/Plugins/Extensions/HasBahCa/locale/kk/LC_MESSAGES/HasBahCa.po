msgid "Access denied or wrong PIN"
msgstr "Кіруге тыйым салынды немесе қате PIN"

msgid "Back"
msgstr "Артқа"

msgid "Congrats! You already have the latest version..."
msgstr "Құттықтаймыз! Сізде соңғы нұсқа әлдеқашан бар..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Жаңартуды ( %s ) қазір орнатқыңыз келе ме?"

msgid "Download Failed!!!"
msgstr "Жүктеп алу сәтсіз аяқталды!!!"

msgid "Downloaded: %d files"
msgstr "Жүктеп алынған: %d файл"

msgid "Downloading ALL playlists..."
msgstr "БАРЛЫҚ ойнату тізімдері жүктеп алынуда..."

msgid "Error checking version: %s"
msgstr "Нұсқаны тексеру қатесі: %s"

msgid "Exit"
msgstr "Шығу"

msgid "Failed: %d files\n"
msgstr "Сәтсіз: %d файл\n"

msgid "Filter this category..."
msgstr "Осы санатты сүзу..."

msgid "Force Update (Developer)"
msgstr "Мәжбүрлеп жаңарту (әзірлеуші)"

msgid "Give me a few seconds ... loading the data"
msgstr "Маған бірнеше секунд беріңіз ... деректерді жүктеп жатырмын"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa таңдаулылар тізімі жойылды"

msgid "Loading data... Please wait"
msgstr "Деректер жүктелуде... Күте тұрыңыз"

msgid "Options"
msgstr "Параметрлер"

msgid "Please now select ..."
msgstr "Қазір таңдаңыз..."

msgid "Remove"
msgstr "Жою"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "Барлық HasBahCa сүйікті букет жойылсын ба?"

msgid "Select"
msgstr "таңдаңыз"

msgid "Select update type:"
msgstr "Жаңарту түрін таңдаңыз:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "Таңдаулы %s тізімін араластыру орындалуда"

msgid "Successfully downloaded: %d files\n"
msgstr "Сәтті жүктелді: %d файл\n"

msgid "Update Aborted!"
msgstr "Жаңарту тоқтатылды!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub сайтынан M3U ойнату тізімдерін жаңартыңыз"

msgid "Update Plugin to new version"
msgstr "Плагинді жаңа нұсқаға жаңартыңыз"

msgid "Wait please ..."
msgstr "Күте тұрыңыз..."
