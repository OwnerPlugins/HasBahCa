msgid "Access denied or wrong PIN"
msgstr "Giriş rədd edildi və ya səhv PIN"

msgid "Back"
msgstr "Geri"

msgid "Congrats! You already have the latest version..."
msgstr "Təbriklər! Sizdə artıq ən son versiya var..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Güncəlləməni ( %s ) indi quraşdırmaq istəyirsiniz?"

msgid "Download Failed!!!"
msgstr "Yükləmə uğursuz oldu!!!"

msgid "Downloaded: %d files"
msgstr "Endirildi: %d fayl"

msgid "Downloading ALL playlists..."
msgstr "BÜTÜN pleylistlər endirilir..."

msgid "Error checking version: %s"
msgstr "Versiya yoxlanarkən xəta: %s"

msgid "Exit"
msgstr "Çıx"

msgid "Failed: %d files\n"
msgstr "Uğursuz: %d fayl\n"

msgid "Filter this category..."
msgstr "Bu kateqoriyanı filtrləyin..."

msgid "Force Update (Developer)"
msgstr "Məcburi Yeniləmə (Tərtibatçı)"

msgid "Give me a few seconds ... loading the data"
msgstr "Mənə bir neçə saniyə verin ... məlumatları yükləyirəm"

