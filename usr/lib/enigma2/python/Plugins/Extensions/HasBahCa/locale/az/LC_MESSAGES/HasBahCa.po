msgid "Successfully downloaded: %d files\n"
msgstr "Uğurla endirildi: %d fayl\n"

msgid "Update Aborted!"
msgstr "Yeniləmə dayandırıldı!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub-dan M3U çalğı siyahılarını yeniləyin"

msgid "Update Plugin to new version"
msgstr "Plugini yeni versiyaya yeniləyin"

msgid "Wait please ..."
msgstr "Gözləyin zəhmət olmasa..."
