msgid "Access denied or wrong PIN"
msgstr "ಪ್ರವೇಶವನ್ನು ನಿರಾಕರಿಸಲಾಗಿದೆ ಅಥವಾ ತಪ್ಪಾದ ಪಿನ್"

msgid "Back"
msgstr "ಹಿಂದೆ"

msgid "Congrats! You already have the latest version..."
msgstr "ಅಭಿನಂದನೆಗಳು! ನೀವು ಈಗಾಗಲೇ ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರುವಿರಿ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ನೀವು ಈಗ ನವೀಕರಣವನ್ನು (%s ) ಸ್ಥಾಪಿಸಲು ಬಯಸುವಿರಾ?"

msgid "Download Failed!!!"
msgstr "ಡೌನ್‌ಲೋಡ್ ವಿಫಲವಾಗಿದೆ!!!"

msgid "Downloaded: %d files"
msgstr "ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಿದೆ: %d ಫೈಲ್‌ಗಳು"

msgid "Downloading ALL playlists..."
msgstr "ಎಲ್ಲಾ ಪ್ಲೇಪಟ್ಟಿಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ..."

msgid "Error checking version: %s"
msgstr "ಆವೃತ್ತಿಯನ್ನು ಪರಿಶೀಲಿಸುವಲ್ಲಿ ದೋಷ: %s"

msgid "Exit"
msgstr "ನಿರ್ಗಮಿಸಿ"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "ವಿಫಲವಾಗಿದೆ: %d ಫೈಲ್‌ಗಳು\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "ಈ ವರ್ಗವನ್ನು ಫಿಲ್ಟರ್ ಮಾಡಿ..."

msgid "Force Update (Developer)"
msgstr "ಫೋರ್ಸ್ ಅಪ್‌ಡೇಟ್ (ಡೆವಲಪರ್)"

msgid "Give me a few seconds ... loading the data"
msgstr "ನನಗೆ ಕೆಲವು ಸೆಕೆಂಡುಗಳನ್ನು ನೀಡಿ ... ಡೇಟಾವನ್ನು ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ಮೆಚ್ಚಿನವುಗಳ ಪಟ್ಟಿಯನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ"

msgid "Loading data... Please wait"
msgstr "ಡೇಟಾವನ್ನು ಲೋಡ್ ಮಾಡಲಾಗುತ್ತಿದೆ... ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ"

msgid "Options"
msgstr "ಆಯ್ಕೆಗಳು"

msgid "Please now select ..."
msgstr "ದಯವಿಟ್ಟು ಈಗ ಆಯ್ಕೆಮಾಡಿ..."

msgid "Remove"
msgstr "ತೆಗೆದುಹಾಕಿ"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "ಎಲ್ಲಾ HasBahCa ಮೆಚ್ಚಿನ ಪುಷ್ಪಗುಚ್ಛವನ್ನು ತೆಗೆದುಹಾಕುವುದೇ?"

msgid "Select"
msgstr "ಆಯ್ಕೆ ಮಾಡಿ"

msgid "Select update type:"
msgstr "ನವೀಕರಣ ಪ್ರಕಾರವನ್ನು ಆಯ್ಕೆಮಾಡಿ:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "ಮೆಚ್ಚಿನ %s ಪಟ್ಟಿಯನ್ನು ಷಫಲ್ ಮಾಡಿ ಪ್ರಗತಿಯಲ್ಲಿದೆ"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "ಯಶಸ್ವಿಯಾಗಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲಾಗಿದೆ: %d ಫೈಲ್‌ಗಳು\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "ನವೀಕರಣವನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಲಾಗಿದೆ!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub ನಿಂದ M3U ಪ್ಲೇಪಟ್ಟಿಗಳನ್ನು ನವೀಕರಿಸಿ"

msgid "Update Plugin to new version"
msgstr "ಪ್ಲಗಿನ್ ಅನ್ನು ಹೊಸ ಆವೃತ್ತಿಗೆ ನವೀಕರಿಸಿ"

msgid "Wait please ..."
msgstr "ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ ..."
