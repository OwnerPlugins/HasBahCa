msgid "Access denied or wrong PIN"
msgstr "ਪਹੁੰਚ ਅਸਵੀਕਾਰ ਜਾਂ ਗਲਤ ਪਿੰਨ"

msgid "Back"
msgstr "ਵਾਪਸ"

msgid "Congrats! You already have the latest version..."
msgstr "ਵਧਾਈਆਂ! ਤੁਹਾਡੇ ਕੋਲ ਪਹਿਲਾਂ ਹੀ ਨਵੀਨਤਮ ਸੰਸਕਰਣ ਹੈ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ਕੀ ਤੁਸੀਂ ਹੁਣੇ ਅੱਪਡੇਟ (%s) ਨੂੰ ਸਥਾਪਿਤ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ?"

msgid "Download Failed!!!"
msgstr "ਡਾਊਨਲੋਡ ਅਸਫਲ !!!"

msgid "Downloaded: %d files"
msgstr "ਡਾਊਨਲੋਡ ਕੀਤਾ: %d ਫ਼ਾਈਲਾਂ"

msgid "Downloading ALL playlists..."
msgstr "ਸਾਰੀਆਂ ਪਲੇਲਿਸਟਾਂ ਨੂੰ ਡਾਊਨਲੋਡ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ..."

msgid "Error checking version: %s"
msgstr "ਸੰਸਕਰਣ ਦੀ ਜਾਂਚ ਕਰਨ ਵਿੱਚ ਤਰੁੱਟੀ: %s"

msgid "Exit"
msgstr "ਨਿਕਾਸ"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "ਅਸਫਲ: %d ਫ਼ਾਈਲਾਂ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "ਇਸ ਸ਼੍ਰੇਣੀ ਨੂੰ ਫਿਲਟਰ ਕਰੋ..."

msgid "Force Update (Developer)"
msgstr "ਜ਼ਬਰਦਸਤੀ ਅੱਪਡੇਟ (ਵਿਕਾਸਕਾਰ)"

msgid "Give me a few seconds ... loading the data"
msgstr "ਮੈਨੂੰ ਕੁਝ ਸਕਿੰਟ ਦਿਓ... ਡਾਟਾ ਲੋਡ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ਮਨਪਸੰਦ ਸੂਚੀ ਹਟਾ ਦਿੱਤੀ ਗਈ ਹੈ"

msgid "Loading data... Please wait"
msgstr "ਡਾਟਾ ਲੋਡ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈ... ਕਿਰਪਾ ਕਰਕੇ ਉਡੀਕ ਕਰੋ"

msgid "Options"
msgstr "ਵਿਕਲਪ"

msgid "Please now select ..."
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਹੁਣ ਚੁਣੋ..."

msgid "Remove"
msgstr "ਹਟਾਓ"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "ਸਾਰੇ HasBahCa ਪਸੰਦੀਦਾ ਗੁਲਦਸਤਾ ਹਟਾਓ?"

msgid "Select"
msgstr "ਚੁਣੋ"

msgid "Select update type:"
msgstr "ਅੱਪਡੇਟ ਕਿਸਮ ਚੁਣੋ:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "ਪ੍ਰਗਤੀ ਵਿੱਚ ਮਨਪਸੰਦ %s ਸੂਚੀ ਨੂੰ ਬਦਲੋ"

#, fuzzy
