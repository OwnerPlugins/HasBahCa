msgstr "ਅੱਪਡੇਟ ਅਧੂਰਾ ਛੱਡਿਆ ਗਿਆ!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub ਤੋਂ M3U ਪਲੇਲਿਸਟਸ ਨੂੰ ਅੱਪਡੇਟ ਕਰੋ"

msgid "Update Plugin to new version"
msgstr "ਪਲੱਗਇਨ ਨੂੰ ਨਵੇਂ ਸੰਸਕਰਣ ਵਿੱਚ ਅੱਪਡੇਟ ਕਰੋ"

msgid "Wait please ..."
msgstr "ਕਿਰਪਾ ਕਰਕੇ ਉਡੀਕ ਕਰੋ..."
