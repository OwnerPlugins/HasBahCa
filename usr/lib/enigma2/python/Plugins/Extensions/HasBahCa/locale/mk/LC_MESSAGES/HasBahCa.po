msgid "Access denied or wrong PIN"
msgstr "Пристапот е одбиен или погрешен ПИН"

msgid "Back"
msgstr "Назад"

msgid "Congrats! You already have the latest version..."
msgstr "Честитки! Веќе ја имате најновата верзија..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Дали сакате да инсталирате ажурирање ( %s ) сега?"

msgid "Download Failed!!!"
msgstr "Преземањето не успеа!!!"

msgid "Downloaded: %d files"
msgstr "Преземени: %d датотеки"

msgid "Downloading ALL playlists..."
msgstr "Се преземаат СИТЕ плејлисти..."

msgid "Error checking version: %s"
msgstr "Грешка при проверка на верзијата: %s"

msgid "Exit"
msgstr "Излезете"

msgid "Failed: %d files\n"
msgstr "Не успеа: %d датотеки\n"

msgid "Filter this category..."
msgstr "Филтрирајте ја оваа категорија..."

msgid "Force Update (Developer)"
msgstr "Присилно ажурирање (програмер)"

msgid "Give me a few seconds ... loading the data"
msgstr "Дајте ми неколку секунди ... вчитување на податоците"

msgid "HasBahCa Favorites List have been removed"
msgstr "Списокот со омилени HasBahCa е отстранет"

msgid "Loading data... Please wait"
msgstr "Се вчитуваат податоци... Ве молиме почекајте"

msgid "Options"
msgstr "Опции"

msgid "Please now select ..."
msgstr "Ве молиме сега изберете ..."

msgid "Remove"
msgstr "Отстрани"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "Да се ​​отстранат сите омилени букети на HasBahCa?"

msgid "Select"
msgstr "Изберете"

msgid "Select update type:"
msgstr "Изберете тип на ажурирање:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "Измешајте го списокот со омилени %s во тек"

msgid "Successfully downloaded: %d files\n"
msgstr "Успешно преземени: %d датотеки\n"

msgid "Update Aborted!"
msgstr "Ажурирањето е прекинато!"

msgid "Update M3U Playlists from GitHub"
msgstr "Ажурирајте ги листите за репродукција M3U од GitHub"

msgid "Update Plugin to new version"
msgstr "Ажурирајте го приклучокот на нова верзија"

msgid "Wait please ..."
msgstr "Чекај те молам..."
