msgid "Access denied or wrong PIN"
msgstr "Kirish taqiqlangan yoki noto'g'ri PIN kod"

msgid "Back"
msgstr "Orqaga"

msgid "Congrats! You already have the latest version..."
msgstr "Tabriklaymiz! Sizda allaqachon oxirgi versiya mavjud..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Yangilanishni ( %s ) hozir oʻrnatmoqchimisiz?"

msgid "Download Failed!!!"
msgstr "Yuklab bo'lmadi!!!"

msgid "Downloaded: %d files"
msgstr "Yuklab olingan: %d ta fayl"

msgid "Downloading ALL playlists..."
msgstr "BARCHA pleylistlar yuklab olinmoqda..."

msgid "Error checking version: %s"
msgstr "Versiyani tekshirishda xatolik yuz berdi: %s"

msgid "Exit"
msgstr "Chiqish"

msgid "Failed: %d files\n"
msgstr "Muvaffaqiyatsiz: %d ta fayl\n"

msgid "Filter this category..."
msgstr "Ushbu turkumni filtrlash..."

msgid "Force Update (Developer)"
msgstr "Majburiy yangilash (ishlab chiquvchi)"

msgid "Give me a few seconds ... loading the data"
msgstr "Menga bir necha soniya vaqt bering ... ma'lumotlarni yuklash"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa Sevimlilar roʻyxati olib tashlandi"

msgid "Loading data... Please wait"
msgstr "Maʼlumotlar yuklanmoqda... Iltimos, kuting"

msgid "Options"
msgstr "Variantlar"

msgid "Please now select ..."
msgstr "Iltimos, hozir tanlang ..."

msgid "Remove"
msgstr "O'chirish"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "Barcha HasBahCa sevimli guldastasini olib tashlang?"

msgid "Select"
msgstr "Tanlang"

msgid "Select update type:"
msgstr "Yangilash turini tanlang:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "Sevimli %s roʻyxatini aralashtirish davom etmoqda"

msgid "Successfully downloaded: %d files\n"
msgstr "Muvaffaqiyatli yuklab olindi: %d ta fayl\n"

msgid "Update Aborted!"
msgstr "Yangilash bekor qilindi!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub-dan M3U pleylistlarini yangilang"

msgid "Update Plugin to new version"
msgstr "Plaginni yangi versiyaga yangilang"

msgid "Wait please ..."
msgstr "Kutib turing, iltimos..."
