msgid "Access denied or wrong PIN"
msgstr "PIN نى رەت قىلدى ياكى خاتا قىلدى"

msgid "Back"
msgstr "قايتىش"

msgid "Congrats! You already have the latest version..."
msgstr "مۇبارەك بولسۇن! سىزدە ئەڭ يېڭى نەشرى بار ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ھازىر يېڭىلاش (% s) نى قاچىلىماقچىمۇ؟"

msgid "Download Failed!!!"
msgstr "چۈشۈرۈش مەغلۇب بولدى !!!"

msgid "Downloaded: %d files"
msgstr "چۈشۈرۈلدى:% d ھۆججەتلەر"

msgid "Downloading ALL playlists..."
msgstr "بارلىق قويۇش تىزىملىكىنى چۈشۈرۈش ..."

msgid "Error checking version: %s"
msgstr "تەكشۈرۈش خاتالىقى:% s"

msgid "Exit"
msgstr "چىقىش"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "مەغلۇپ بولدى:% d ھۆججەتلەر \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ n"

msgid "Filter this category..."
msgstr "بۇ تۈرنى سۈزۈڭ ..."

msgid "Force Update (Developer)"
msgstr "كۈچ يېڭىلاش (ئىجادكار)"

msgid "Give me a few seconds ... loading the data"
msgstr "ماڭا بىر نەچچە سېكۇنت بېرىڭ ... سانلىق مەلۇماتنى يۈكلەڭ"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ياقتۇرىدىغان تىزىملىكى ئۆچۈرۈلدى"

msgid "Loading data... Please wait"
msgstr "سانلىق مەلۇمات يۈكلەۋاتىدۇ ... ساقلاپ تۇرۇڭ"

msgid "Options"
msgstr "تاللانما"

msgid "Please now select ..."
msgstr "ھازىر تاللاڭ ..."

msgid "Remove"
msgstr "ئۆچۈرۈڭ"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "HasBahCa ئەڭ ياخشى كۆرىدىغان گۈلنى ئۆچۈرۈڭ؟"

msgid "Select"
msgstr "تاللاڭ"

msgid "Select update type:"
msgstr "يېڭىلاش تىپىنى تاللاڭ:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "ئالغا ئىلگىرىلەۋاتقان ئەڭ ياخشى كۆرىدىغان% s تىزىملىكى"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "مۇۋەپپەقىيەتلىك چۈشۈرۈلدى:% d ھۆججەت \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\ n"

msgid "Update Aborted!"
msgstr "يېڭىلانغان ئەمەلدىن قالدۇرۇلدى!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub دىن M3U قويۇش تىزىملىكىنى يېڭىلاڭ"

msgid "Update Plugin to new version"
msgstr "قىستۇرمىنى يېڭى نەشرىگە يېڭىلاڭ"

msgid "Wait please ..."
msgstr "ساقلاپ تۇرۇڭ ..."
