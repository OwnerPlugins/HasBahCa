msgid "Access denied or wrong PIN"
msgstr "אַקסעס געלייקנט אָדער פאַלש PIN"

msgid "Back"
msgstr "צוריק"

msgid "Congrats! You already have the latest version..."
msgstr "מאַזל - טאָוו! איר האָט שוין די לעצטע ווערסיע ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "צי איר ווילן צו ינסטאַלירן דערהייַנטיקן (%s) איצט?"

msgid "Download Failed!!!"
msgstr "אראפקאפיע ניט אַנדערש!!!"

msgid "Downloaded: %d files"
msgstr "דאַונלאָודיד: %d טעקעס"

msgid "Downloading ALL playlists..."
msgstr "דאַונלאָודינג אַלע פּלייַליסץ ..."

msgid "Error checking version: %s"
msgstr "טעות טשעק ווערסיע: %s"

msgid "Exit"
msgstr "אַרויסגאַנג"

msgid "Failed: %d files\\\\\\\\n"
msgstr "דורכפאַל: %d טעקעס\\\\\\\\n"

msgid "Filter this category..."
msgstr "פילטער די קאטעגאריע..."

msgid "Force Update (Developer)"
msgstr "פאָרס אַפּדייט (דעוועלאָפּער)"

msgid "Give me a few seconds ... loading the data"
msgstr "געבן מיר אַ ביסל סעקונדעס ... לאָודינג די דאַטן"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa פאַוואָריטעס רשימה איז אַוועקגענומען"

msgid "Loading data... Please wait"
msgstr "לאָודינג דאַטן... ביטע וואַרטן"

msgid "Options"
msgstr "אָפּציעס"

msgid "Please now select ..."
msgstr "ביטע איצט אויסקלייַבן ..."

msgid "Remove"
msgstr "אַראָפּנעמען"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "אַראָפּנעמען אַלע HasBahCa באַליבסטע בוקיי?"

msgid "Select"
msgstr "אויסקלייַבן"

msgid "Select update type:"
msgstr "אויסקלייַבן דערהייַנטיקן טיפּ:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "שאַרן באַליבסטע %s רשימה אין פּראָגרעס"

msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "געראָטן דאַונלאָודיד: %d טעקעס\\\\\\\\n"

msgid "Update Aborted!"
msgstr "דערהייַנטיקן אַבאָרטיד!"

msgid "Update M3U Playlists from GitHub"
msgstr "דערהייַנטיקן M3U פּלייַליסץ פֿון GitHub"

msgid "Update Plugin to new version"
msgstr "דערהייַנטיקן פּלוגין צו נייַע ווערסיע"

msgid "Wait please ..."
msgstr "ווארט ביטע..."
