msgid "Access denied or wrong PIN"
msgstr "წვდომა აკრძალულია ან არასწორი PIN"

msgid "Back"
msgstr "უკან"

msgid "Congrats! You already have the latest version..."
msgstr "გილოცავ! თქვენ უკვე გაქვთ უახლესი ვერსია..."

msgid "Do you want to install update ( %s ) now?"
msgstr "გსურთ განახლების ( %s) ინსტალაცია ახლა?"

msgid "Download Failed!!!"
msgstr "ჩამოტვირთვა ვერ მოხერხდა!!!"

msgid "Downloaded: %d files"
msgstr "ჩამოტვირთულია: %d ფაილი"

msgid "Downloading ALL playlists..."
msgstr "მიმდინარეობს ყველა დასაკრავი სიის ჩამოტვირთვა..."

msgid "Error checking version: %s"
msgstr "შეცდომა ვერსიის შემოწმებისას: %s"

msgid "Exit"
msgstr "გასვლა"

msgid "Failed: %d files\n"
msgstr "ვერ მოხერხდა: %d ფაილი\n"

msgid "Filter this category..."
msgstr "ამ კატეგორიის გაფილტვრა..."

msgid "Force Update (Developer)"
msgstr "იძულებითი განახლება (დეველოპერი)"

msgid "Give me a few seconds ... loading the data"
msgstr "მომეცი რამდენიმე წამი ... მონაცემების ჩატვირთვა"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ფავორიტების სია ამოღებულია"

msgid "Loading data... Please wait"
msgstr "იტვირთება მონაცემები... გთხოვთ დაელოდოთ"

msgid "Options"
msgstr "ოფციები"

msgid "Please now select ..."
msgstr "გთხოვთ ახლა შეარჩიოთ..."

msgid "Remove"
msgstr "ამოღება"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "წაშალოთ ყველა HasBahCa-ს საყვარელი თაიგული?"

msgid "Select"
msgstr "აირჩიეთ"

msgid "Select update type:"
msgstr "აირჩიეთ განახლების ტიპი:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "რჩეული %s სიის არევა მიმდინარეობს"

msgid "Successfully downloaded: %d files\n"
msgstr "წარმატებით ჩამოიტვირთა: %d ფაილი\n"

msgid "Update Aborted!"
msgstr "განახლება შეწყდა!"

msgid "Update M3U Playlists from GitHub"
msgstr "განაახლეთ M3U დასაკრავი სიები GitHub-დან"

msgid "Update Plugin to new version"
msgstr "განაახლეთ დანამატი ახალ ვერსიაზე"

msgid "Wait please ..."
msgstr "დაელოდე გთხოვ..."
