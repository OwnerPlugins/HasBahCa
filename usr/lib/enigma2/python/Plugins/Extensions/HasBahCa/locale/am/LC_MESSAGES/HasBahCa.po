msgid "Access denied or wrong PIN"
msgstr "መዳረሻ ተከልክሏል ወይም የተሳሳተ ፒን"

msgid "Back"
msgstr "ተመለስ"

msgid "Congrats! You already have the latest version..."
msgstr "እንኳን ደስ ያለህ! ቀድሞውንም የቅርብ ጊዜ ስሪት አለህ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ማሻሻያ (%s) አሁን መጫን ይፈልጋሉ?"

msgid "Download Failed!!!"
msgstr "ማውረድ አልተሳካም !!!"

msgid "Downloaded: %d files"
msgstr "የወረዱ፡ %d ፋይሎች"

msgid "Downloading ALL playlists..."
msgstr "ሁሉንም አጫዋች ዝርዝሮች በማውረድ ላይ..."

msgid "Error checking version: %s"
msgstr "ስሪቱን በመፈተሽ ላይ ስህተት፡%s"

msgid "Exit"
msgstr "ውጣ"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "አልተሳካም፡ %d ፋይሎች\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "ይህን ምድብ አጣራ..."

msgid "Force Update (Developer)"
msgstr "ዝማኔን አስገድድ (ገንቢ)"

msgid "Give me a few seconds ... loading the data"
msgstr "ጥቂት ሰከንዶች ስጠኝ ... ውሂቡን እየጫንኩ ነው።"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ተወዳጆች ዝርዝር ተወግዷል"

msgid "Loading data... Please wait"
msgstr "ውሂብ በመጫን ላይ... እባክዎ ይጠብቁ"

msgid "Options"
msgstr "አማራጮች"

msgid "Please now select ..."
msgstr "እባክህ አሁን ምረጥ..."

msgid "Remove"
msgstr "አስወግድ"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "ሁሉም የHasBahCa ተወዳጅ ቡኬት ይወገድ?"

msgid "Select"
msgstr "ይምረጡ"

msgid "Select update type:"
msgstr "የዝማኔ አይነት ይምረጡ፡-"

msgid "Shuffle Favorite %s List in Progress"
msgstr "በሂደት ላይ ያለ ተወዳጅ %s ዝርዝርን በውዝ"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "በተሳካ ሁኔታ ወርዷል፡ %d ፋይሎች\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "ዝማኔ ተቋርጧል!"

msgid "Update M3U Playlists from GitHub"
msgstr "የM3U አጫዋች ዝርዝሮችን ከ GitHub ያዘምኑ"

msgid "Update Plugin to new version"
msgstr "ተሰኪን ወደ አዲስ ስሪት ያዘምኑ"

msgid "Wait please ..."
msgstr "ቆይ እባክህ..."
