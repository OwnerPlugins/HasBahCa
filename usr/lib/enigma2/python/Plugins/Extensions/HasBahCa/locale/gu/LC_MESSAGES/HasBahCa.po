msgid "Access denied or wrong PIN"
msgstr "ઍક્સેસ નકારી અથવા ખોટો PIN"

msgid "Back"
msgstr "પાછળ"

msgid "Congrats! You already have the latest version..."
msgstr "અભિનંદન! તમારી પાસે પહેલેથી જ નવીનતમ સંસ્કરણ છે..."

msgid "Do you want to install update ( %s ) now?"
msgstr "શું તમે હમણાં અપડેટ (%s) ઇન્સ્ટોલ કરવા માંગો છો?"

msgid "Download Failed!!!"
msgstr "ડાઉનલોડ નિષ્ફળ !!!"

msgid "Downloaded: %d files"
msgstr "ડાઉનલોડ કરેલ: %d ફાઇલો"

msgid "Downloading ALL playlists..."
msgstr "તમામ પ્લેલિસ્ટ ડાઉનલોડ કરી રહ્યાં છીએ..."

msgid "Error checking version: %s"
msgstr "સંસ્કરણ તપાસવામાં ભૂલ: %s"

msgid "Exit"
msgstr "બહાર નીકળો"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "નિષ્ફળ: %d ફાઇલો\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "આ શ્રેણીને ફિલ્ટર કરો..."

msgid "Force Update (Developer)"
msgstr "ફોર્સ અપડેટ (વિકાસકર્તા)"

msgid "Give me a few seconds ... loading the data"
msgstr "મને થોડી સેકન્ડ આપો... ડેટા લોડ કરી રહ્યા છીએ"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa મનપસંદ યાદી દૂર કરવામાં આવી છે"

msgid "Loading data... Please wait"
msgstr "ડેટા લોડ કરી રહ્યું છે... કૃપા કરીને રાહ જુઓ"

msgid "Options"
msgstr "વિકલ્પો"

msgid "Please now select ..."
msgstr "કૃપા કરીને હવે પસંદ કરો..."

msgid "Remove"
msgstr "દૂર કરો"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "બધા HasBahCa મનપસંદ કલગી દૂર કરો?"

msgid "Select"
msgstr "પસંદ કરો"

msgid "Select update type:"
msgstr "અપડેટ પ્રકાર પસંદ કરો:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "મનપસંદ %s સૂચિને શફલ કરો પ્રક્રિયામાં છે"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "સફળતાપૂર્વક ડાઉનલોડ: %d ફાઇલો\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "અપડેટ રદ કર્યું!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub થી M3U પ્લેલિસ્ટ અપડેટ કરો"

msgid "Update Plugin to new version"
msgstr "પ્લગઇનને નવા સંસ્કરણ પર અપડેટ કરો"

msgid "Wait please ..."
msgstr "કૃપા કરીને રાહ જુઓ ..."
