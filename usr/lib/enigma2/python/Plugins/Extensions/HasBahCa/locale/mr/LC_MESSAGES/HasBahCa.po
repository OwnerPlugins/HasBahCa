msgid "Access denied or wrong PIN"
msgstr "प्रवेश नाकारला किंवा चुकीचा पिन"

msgid "Back"
msgstr "मागे"

msgid "Congrats! You already have the latest version..."
msgstr "अभिनंदन! तुमच्याकडे आधीपासूनच नवीनतम आवृत्ती आहे..."

msgid "Do you want to install update ( %s ) now?"
msgstr "तुम्हाला आता अपडेट (%s) स्थापित करायचे आहे का?"

msgid "Download Failed!!!"
msgstr "डाउनलोड अयशस्वी !!!"

msgid "Downloaded: %d files"
msgstr "डाउनलोड केले: %d फाइल्स"

msgid "Downloading ALL playlists..."
msgstr "सर्व प्लेलिस्ट डाउनलोड करत आहे..."

msgid "Error checking version: %s"
msgstr "आवृत्ती तपासताना त्रुटी: %s"

msgid "Exit"
msgstr "बाहेर पडा"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "अयशस्वी: %d फाइल्स\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "ही श्रेणी फिल्टर करा..."

msgid "Force Update (Developer)"
msgstr "फोर्स अपडेट (डेव्हलपर)"

msgid "Give me a few seconds ... loading the data"
msgstr "मला काही सेकंद द्या... डेटा लोड करत आहे"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ची आवडती यादी काढून टाकली आहे"

msgid "Loading data... Please wait"
msgstr "डेटा लोड करत आहे... कृपया प्रतीक्षा करा"

msgid "Options"
msgstr "पर्याय"

msgid "Please now select ..."
msgstr "कृपया आता निवडा..."

msgid "Remove"
msgstr "काढा"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "सर्व HasBahCa आवडते पुष्पगुच्छ काढायचे?"

msgid "Select"
msgstr "निवडा"

msgid "Select update type:"
msgstr "अद्यतन प्रकार निवडा:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "आवडीची %s यादी शफल करा प्रगतीपथावर"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "यशस्वीरित्या डाउनलोड केले: %d फाइल्स\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "अद्यतन रद्द केले!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub वरून M3U प्लेलिस्ट अपडेट करा"

msgid "Update Plugin to new version"
msgstr "नवीन आवृत्तीवर प्लगइन अद्यतनित करा"

msgid "Wait please ..."
msgstr "कृपया थांबा..."
