msgid "Access denied or wrong PIN"
msgstr "Piekļuve liegta vai nepareizs PIN"

msgid "Back"
msgstr "Atpakaļ"

msgid "Congrats! You already have the latest version..."
msgstr "Apsveicam! Jums jau ir jaunākā versija..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Vai vēlaties instalēt atjauninājumu ( %s ) tūlīt?"

msgid "Download Failed!!!"
msgstr "Lejupielāde neizdevās!!!"

msgid "Downloaded: %d files"
msgstr "Lejupielādēti: %d faili"

msgid "Downloading ALL playlists..."
msgstr "Notiek VISU atskaņošanas sarakstu lejupielāde..."

msgid "Error checking version: %s"
msgstr "Pārbaudot versiju, radās kļūda: %s"

msgid "Exit"
msgstr "Iziet"

msgid "Failed: %d files\n"
msgstr "Neizdevās: %d faili\n"

msgid "Filter this category..."
msgstr "Filtrēt šo kategoriju..."

msgid "Force Update (Developer)"
msgstr "Piespiedu atjaunināšana (izstrādātājs)"

msgid "Give me a few seconds ... loading the data"
msgstr "Dodiet man dažas sekundes ... datu ielāde"

