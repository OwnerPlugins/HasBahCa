msgstr "Notiek izlases %s saraksts jauktā secībā"

msgid "Successfully downloaded: %d files\n"
msgstr "Veiksmīgi lejupielādēti: %d faili\n"

msgid "Update Aborted!"
msgstr "Atjaunināšana pārtraukta!"

msgid "Update M3U Playlists from GitHub"
msgstr "Atjauniniet M3U atskaņošanas sarakstus no GitHub"

msgid "Update Plugin to new version"
msgstr "Atjauniniet spraudni uz jaunu versiju"

msgid "Wait please ..."
msgstr "Pagaidi lūdzu..."
