msgstr "Да ли желите да инсталирате ажурирање ( %с ) сада?"

msgid "Download Failed!!!"
msgstr "Преузимање није успело!!!"

msgid "Downloaded: %d files"
msgstr "Преузето: %д датотека"

msgid "Downloading ALL playlists..."
