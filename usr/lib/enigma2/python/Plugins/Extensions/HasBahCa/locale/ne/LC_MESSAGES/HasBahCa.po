msgid "Access denied or wrong PIN"
msgstr "पहुँच अस्वीकृत वा गलत PIN"

msgid "Back"
msgstr "पछाडि"

msgid "Congrats! You already have the latest version..."
msgstr "बधाई छ! तपाईंसँग पहिले नै नवीनतम संस्करण छ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "के तपाई अहिले अपडेट (%s) स्थापना गर्न चाहनुहुन्छ?"

msgid "Download Failed!!!"
msgstr "डाउनलोड असफल !!!"

msgid "Downloaded: %d files"
msgstr "डाउनलोड गरिएको: %d फाइलहरू"

msgid "Downloading ALL playlists..."
msgstr "सबै प्लेलिस्टहरू डाउनलोड गर्दै..."

msgid "Error checking version: %s"
msgstr "संस्करण जाँच गर्दा त्रुटि: %s"

msgid "Exit"
msgstr "बाहिर निस्कनुहोस्"

msgid "Failed: %d files\n"
msgstr "असफल: %d फाइलहरू\n"

msgid "Filter this category..."
msgstr "यो श्रेणी फिल्टर गर्नुहोस्..."

msgid "Force Update (Developer)"
msgstr "बल अपडेट (विकासकर्ता)"

msgid "Give me a few seconds ... loading the data"
msgstr "मलाई केहि सेकेन्ड दिनुहोस् ... डाटा लोड गर्दै"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa मनपर्ने सूची हटाइयो"

msgid "Loading data... Please wait"
msgstr "डेटा लोड गर्दै... कृपया प्रतीक्षा गर्नुहोस्"

msgid "Options"
msgstr "विकल्पहरू"

msgid "Please now select ..."
msgstr "कृपया अब चयन गर्नुहोस् ..."

msgid "Remove"
msgstr "हटाउनुहोस्"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "सबै HasBahCa मनपर्ने गुच्छा हटाउनुहोस्?"

msgid "Select"
msgstr "चयन गर्नुहोस्"

msgid "Select update type:"
msgstr "अपडेट प्रकार चयन गर्नुहोस्:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "मनपर्ने %s सूची प्रगतिमा छ"

msgid "Successfully downloaded: %d files\n"
msgstr "सफलतापूर्वक डाउनलोड गरियो: %d फाइलहरू\n"

msgid "Update Aborted!"
msgstr "अपडेट रद्द गरियो!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub बाट M3U प्लेलिस्टहरू अपडेट गर्नुहोस्"

msgid "Update Plugin to new version"
msgstr "नयाँ संस्करणमा प्लगइन अपडेट गर्नुहोस्"

msgid "Wait please ..."
msgstr "कृपया प्रतीक्षा गर्नुहोस् ..."
