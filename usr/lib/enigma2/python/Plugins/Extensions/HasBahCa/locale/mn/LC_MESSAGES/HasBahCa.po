msgid "Do you want to install update ( %s ) now?"
msgstr "Та одоо шинэчлэлтийг ( %s ) суулгахыг хүсэж байна уу?"

msgid "Download Failed!!!"
msgstr "Татаж чадсангүй!!!"

msgid "Downloaded: %d files"
msgstr "Татаж авсан: %d файл"

msgid "Downloading ALL playlists..."
msgstr "БҮХ тоглуулах жагсаалтыг татаж байна..."

msgid "Error checking version: %s"
msgstr "Хувилбарыг шалгахад алдаа гарлаа: %s"

msgid "Exit"
msgstr "Гарах"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "Амжилтгүй: %d файл\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "Энэ ангиллыг шүүх..."

msgid "Force Update (Developer)"
msgstr "Хүчээр шинэчлэх (Хөгжүүлэгч)"

msgid "Give me a few seconds ... loading the data"
msgstr "Надад хэдэн секунд өгөөч ... өгөгдлийг ачаалж байна"

