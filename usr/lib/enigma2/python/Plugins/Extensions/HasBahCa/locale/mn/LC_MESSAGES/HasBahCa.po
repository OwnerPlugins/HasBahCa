msgstr "Амжилттай татагдсан: %d файл\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "Шинэчлэлтийг зогсоосон!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub-аас M3U тоглуулах жагсаалтыг шинэчил"

msgid "Update Plugin to new version"
msgstr "Plugin-ийг шинэ хувилбар руу шинэчилнэ үү"

msgid "Wait please ..."
msgstr "Хүлээгээрэй..."
