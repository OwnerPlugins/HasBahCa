msgid "Access denied or wrong PIN"
msgstr "ප්‍රවේශය ප්‍රතික්ෂේප කිරීම හෝ වැරදි PIN අංකය"

msgid "Back"
msgstr "ආපසු"

msgid "Congrats! You already have the latest version..."
msgstr "සුභ පැතුම්! ඔබට දැනටමත් නවතම අනුවාදය ඇත..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ඔබට දැන් යාවත්කාලීන (%s ) ස්ථාපනය කිරීමට අවශ්‍යද?"

msgid "Download Failed!!!"
msgstr "බාගැනීම අසාර්ථකයි!!!"

msgid "Downloaded: %d files"
msgstr "බාගත්: ගොනු %d"

msgid "Downloading ALL playlists..."
msgstr "සියලුම ධාවන ලැයිස්තු බාගනිමින්..."

msgid "Error checking version: %s"
msgstr "අනුවාදය පරීක්ෂා කිරීමේ දෝෂයකි: %s"

msgid "Exit"
msgstr "පිටවීම"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "අසාර්ථකයි: ගොනු %d\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "මෙම ප්‍රවර්ගය පෙරහන් කරන්න..."

msgid "Force Update (Developer)"
msgstr "බල යාවත්කාලීන (සංවර්ධක)"

msgid "Give me a few seconds ... loading the data"
msgstr "මට තත්පර කිහිපයක් දෙන්න ... දත්ත පූරණය කරමින්"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa ප්‍රියතම ලැයිස්තුව ඉවත් කර ඇත"

msgid "Loading data... Please wait"
msgstr "දත්ත පූරණය කරමින්... කරුණාකර රැඳී සිටින්න"

msgid "Options"
msgstr "විකල්ප"

msgid "Please now select ..."
msgstr "කරුණාකර දැන් තෝරන්න ..."

msgid "Remove"
msgstr "ඉවත් කරන්න"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "HasBahCa ප්‍රියතම මල් කළඹ සියල්ල ඉවත් කරන්නද?"

msgid "Select"
msgstr "තෝරන්න"

msgid "Select update type:"
msgstr "යාවත්කාලීන වර්ගය තෝරන්න:"

msgid "Shuffle Favorite %s List in Progress"
msgstr "ප්‍රියතම %s ලැයිස්තුව කලවම් කරන්න"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "සාර්ථකව බාගන්නා ලදී: ගොනු %d\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "යාවත්කාලීන කිරීම නවත්වන ලදී!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub වෙතින් M3U ධාවන ලැයිස්තු යාවත්කාලීන කරන්න"

msgid "Update Plugin to new version"
msgstr "ප්ලගිනය නව අනුවාදයට යාවත්කාලීන කරන්න"

msgid "Wait please ..."
msgstr "කරුණාකර ඉන්න..."
