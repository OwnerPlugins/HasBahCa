msgid "Access denied or wrong PIN"
msgstr "Кирүү четке кагылды же туура эмес PIN"

msgid "Back"
msgstr "Артка"

msgid "Congrats! You already have the latest version..."
msgstr "Куттуктайбыз! Сизде мурунтан эле акыркы версия бар..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Жаңыртууну ( %s ) азыр орноткуңуз келеби?"

msgid "Download Failed!!!"
msgstr "Жүктөп алуу ишке ашкан жок!!!"

msgid "Downloaded: %d files"
msgstr "Жүктөлгөн: %d файл"

msgid "Downloading ALL playlists..."
msgstr "БАРДЫК ойнотмо тизмелер жүктөлүүдө..."

msgid "Error checking version: %s"
msgstr "Версияны текшерүү катасы: %s"

msgid "Exit"
msgstr "Чыгыңыз"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "Ишке ашкан жок: %d файл\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "Бул категорияны чыпкалоо..."

msgid "Force Update (Developer)"
msgstr "Күчтүү жаңыртуу (иштеп чыгуучу)"

msgid "Give me a few seconds ... loading the data"
msgstr "Мага бир нече секунд бериңиз ... маалыматтарды жүктөө"

