msgstr "Сүйүктүү %s тизмени аралаштыруу аткарылууда"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "Ийгиликтүү жүктөлүп алынды: %d файл\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "Жаңыртуу токтотулду!"

msgid "Update M3U Playlists from GitHub"
msgstr "GitHub'дан M3U ойнотмо тизмелерин жаңыртыңыз"

msgid "Update Plugin to new version"
msgstr "Плагинди жаңы версияга жаңыртыңыз"

msgid "Wait please ..."
msgstr "Күтө туруңуз..."
