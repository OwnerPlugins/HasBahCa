msgid "Options"
msgstr "Параметрлер"

msgid "Please now select ..."
msgstr "Сураныч, азыр тандаңыз ..."

msgid "Remove"
msgstr "Алып салуу"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "Бардык HasBahCa Favorite Bouquet алынып салынсынбы?"

msgid "Select"
msgstr "Тандоо"

msgid "Select update type:"
msgstr "Жаңыртуу түрүн тандаңыз:"

