msgid "Access denied or wrong PIN"
msgstr "Մուտքը մերժված է կամ սխալ PIN"

msgid "Back"
msgstr "Ետ"

msgid "Congrats! You already have the latest version..."
msgstr "Շնորհավորում եմ Դուք արդեն ունեք վերջին տարբերակը..."

msgid "Do you want to install update ( %s ) now?"
msgstr "Ցանկանու՞մ եք տեղադրել թարմացումը ( %s ) հիմա:"

msgid "Download Failed!!!"
msgstr "Ներբեռնումը ձախողվեց!!!"

msgid "Downloaded: %d files"
msgstr "Ներբեռնված՝ %d ֆայլ"

msgid "Downloading ALL playlists..."
msgstr "ԲՈԼՈՐ երգացանկերի ներբեռնում..."

msgid "Error checking version: %s"
msgstr "Չհաջողվեց ստուգել տարբերակը՝ %s"

msgid "Exit"
msgstr "Ելք"

#, fuzzy
msgid "Failed: %d files\\\\\\\\n"
msgstr "Չհաջողվեց՝ %d ֆայլ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Filter this category..."
msgstr "Զտել այս կատեգորիան..."

msgid "Force Update (Developer)"
msgstr "Պարտադիր թարմացում (մշակող)"

msgid "Give me a few seconds ... loading the data"
msgstr "Տվեք ինձ մի քանի վայրկյան ... տվյալների բեռնում"

msgid "HasBahCa Favorites List have been removed"
msgstr "HasBahCa-ի ընտրյալների ցանկը հեռացվել է"

msgid "Loading data... Please wait"
msgstr "Տվյալների բեռնում... Խնդրում ենք սպասել"

msgid "Options"
msgstr "Ընտրանքներ"

msgid "Please now select ..."
msgstr "Խնդրում ենք հիմա ընտրել..."

msgid "Remove"
msgstr "Հեռացնել"

msgid "Remove all HasBahCa Favorite Bouquet ?"
msgstr "Հեռացնե՞լ բոլոր HasBahCa-ի սիրելի ծաղկեփունջը:"

msgid "Select"
msgstr "Ընտրել"

msgid "Select update type:"
msgstr "Ընտրեք թարմացման տեսակը՝"

msgid "Shuffle Favorite %s List in Progress"
msgstr "Խառնել սիրված %s ցուցակն ընթացքի մեջ է"

#, fuzzy
msgid "Successfully downloaded: %d files\\\\\\\\n"
msgstr "Հաջողությամբ ներբեռնվեց՝ %d ֆայլ\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n"

msgid "Update Aborted!"
msgstr "Թարմացումը ընդհատվեց:"

msgid "Update M3U Playlists from GitHub"
msgstr "Թարմացրեք M3U երգացանկերը GitHub-ից"

msgid "Update Plugin to new version"
msgstr "Թարմացրեք Plugin-ը նոր տարբերակի"

msgid "Wait please ..."
msgstr "Սպասիր խնդրում եմ..."
